        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "from sklearn.decomposition import PCA\n",
        "\n",
        "# 1. 数据准备：将绝对丰度转换为相对丰度，并转置矩阵\n",
        "otu_rel = otu_df.div(otu_df.sum(axis=0), axis=1)\n",
        "otu_t = otu_rel.T\n",
        "\n",
        "# === 【关键修复：满足 sklearn 的数据格式强迫症】 ===\n",
        "# 强制将所有列名统一转换成字符串格式，防止报 TypeError\n",
        "otu_t.columns = otu_t.columns.astype(str)\n",
        "# ===================================================\n",
        "\n",
        "# 2. 样本对齐：确保 Metadata 的第一列变成索引\n",
        "meta_plot = meta_df.copy()\n",
        "if meta_plot.index.name is None or meta_plot.index.name == 'index':\n",
        "    meta_plot = meta_plot.set_index(meta_plot.columns[0])\n",
        "\n",
        "# 找到两者共有的样本\n",
        "common_samples = otu_t.index.intersection(meta_plot.index)\n",
        "otu_t = otu_t.loc[common_samples]\n",
        "meta_plot = meta_plot.loc[common_samples]\n",
        "\n",
        "# 3. 运行核心降维算法 (PCA)\n",
        "pca = PCA(n_components=2)\n",
        "pca_result = pca.fit_transform(otu_t)\n",
        "\n",
        "# 获取两个主成分的解释度\n",
        "pc1_var = pca.explained_variance_ratio_[0] * 100\n",
        "pc2_var = pca.explained_variance_ratio_[1] * 100\n",
        "\n",
        "# 4. 合并坐标轴数据与实验分组数据\n",
        "plot_data = pd.DataFrame({\n",
        "    'PC1': pca_result[:, 0],\n",
        "    'PC2': pca_result[:, 1]\n",
        "}, index=otu_t.index)\n",
        "plot_data = plot_data.join(meta_plot)\n",
        "\n",
        "color_col = 'Description'  \n",
        "print(f\"✅ 降维完成！正在使用 '{color_col}' 列对样本进行分组上色...\")\n",
        "\n",
        "# 5. 使用 seaborn 绘制高颜值散点图\n",
        "plt.figure(figsize=(10, 8))\n",
        "sns.scatterplot(\n",
        "    data=plot_data, \n",
        "    x='PC1', y='PC2',\n",
        "    hue=color_col,\n",
        "    style=color_col,\n",
        "    s=200,\n",
        "    alpha=0.85,\n",
        "    palette='Set1',\n",
        "    edgecolor='black'\n",
        ")\n",
        "\n",
        "# 6. 图表细节美化\n",
        "plt.title('Microbiome PCA Plot', fontsize=18, pad=15)\n",
        "plt.xlabel(f'PC1 ({pc1_var:.1f}%)', fontsize=14)\n",
        "plt.ylabel(f'PC2 ({pc2_var:.1f}%)', fontsize=14)\n",
        "plt.axhline(0, color='grey', linestyle='--', linewidth=1) \n",
        "plt.axvline(0, color='grey', linestyle='--', linewidth=1)\n",
        "plt.legend(bbox_to_anchor=(1.02, 1), loc='upper left', title=color_col, fontsize=12)\n",
        "plt.tight_layout()\n",
        "\n",
        "# 展示成果\n",
        "plt.show()"
